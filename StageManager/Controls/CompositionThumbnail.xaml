<UserControl
    x:Class="StageManager.Controls.CompositionThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StageManager.Controls"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid>
        <Border Background="#01000000">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20" />
            </Border.Effect>
        </Border>
        <!-- HostContainer is a sibling of Border (not a child) so it can grow
             past the WPF layout slot via SizeChanged code-behind, giving the
             composition HWND headroom for hover-scale without chopping the
             rounded clip at the HWND boundary. -->
        <Grid x:Name="HostContainer"
              Background="#01000000"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        <!-- Stand-in for a window Windows refuses to capture (the app set a display
             affinity). DataContext is the tile's WindowModel, so the icon binds directly. -->
        <Border x:Name="Placeholder"
                Visibility="Collapsed"
                CornerRadius="8"
                Background="#E6262626"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
            <Image Source="{Binding Icon}"
                   Width="44"
                   Height="44"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
