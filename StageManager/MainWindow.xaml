<Window
    x:Class="StageManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:StageManager"
    xmlns:controls="clr-namespace:StageManager.Controls"
    xmlns:conv="clr-namespace:StageManager.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    mc:Ignorable="d"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Topmost="False"
    WindowStyle="None"
    Title="MainWindow"
    Height="450"
    Width="240"
    ShowActivated="False"
    Background="Transparent"
    Name="thisWindow">
    <Window.Resources>
        <Style
            x:Key="SceneOpacity"
            TargetType="{x:Type Grid}">
            <!-- Origin 0,0.5: the tray aligns every tile on a shared left edge, so the
                 pop has to grow rightward and downward-from-centre only. A centred
                 origin pushed the left edge out by (scale-1)*width/2 and a hovered
                 tile visibly broke the column. CompositionThumbnail.ComposeTransform
                 mirrors this anchor for the HwndHost surface. -->
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1.08" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1.08" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="0.96" Duration="0:0:0.08">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="0.96" Duration="0:0:0.08">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.08" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.08" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <conv:IndexToOffsetMarginConverter x:Key="IndexToOffsetMarginConverter" />
        <conv:IndexToZIndexConverter x:Key="IndexToZIndexConverter" />
    </Window.Resources>
    <StackPanel
        VerticalAlignment="Center">
        <ItemsControl
            Name="scenesControl"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Padding="22, 0, 0, 0"
            ItemsSource="{Binding Scenes}"
            PreviewMouseLeftButtonDown="ScenesControl_PreviewMouseLeftButtonDown"
            MouseMove="ScenesControl_MouseMove"
            PreviewMouseLeftButtonUp="ScenesControl_PreviewMouseLeftButtonUp">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,28"
                        Visibility="{Binding Visibility}"
                        Style="{StaticResource SceneOpacity}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger
                                EventName="MouseLeftButtonUp">
                                <i:InvokeCommandAction
                                    Command="{Binding SwitchSceneCommand, Mode=OneTime, Source={x:Reference thisWindow}}"
                                    CommandParameter="{Binding .}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <!-- Windows -->
                        <ItemsControl
                            ItemsSource="{Binding Windows}"
                            AlternationCount="1000">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid
                                        Margin="0,0,0,0"></Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- HorizontalAlignment=Left is load-bearing: the panel is a
                                         Grid and these tiles carry an explicit Width, so the WPF
                                         default (Stretch) CENTRES each one in the row. Scenes whose
                                         windows differ in width then get different left edges, and
                                         within a scene the first window no longer lines up with the
                                         other apps. Left pins every tile's left edge to the row
                                         origin; the deliberate 10px-per-index cascade below (see
                                         IndexToOffsetMarginConverter) then offsets from there, so
                                         index 0 sits flush left. -->
                                    <controls:CompositionThumbnail
                                        PreviewHandle="{Binding Handle}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        TopEdgeDegrees="{Binding DataContext.TiltTopDegrees, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        BottomEdgeDegrees="{Binding DataContext.TiltBottomDegrees, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        Width="{Binding PreviewWidth}"
                                        Height="{Binding PreviewHeight}"
                                        MirrorScale="{Binding RenderTransform.(ScaleTransform.ScaleX), RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        MirrorOpacity="{Binding Opacity, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=2}}"
                                        Margin="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToOffsetMarginConverter}}"
                                        Panel.ZIndex="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexToZIndexConverter}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Shown when more apps are waiting than the strip displays (Settings → Apps in the
             strip). Opens a list of the rest; picking one brings it on stage. -->
        <Button
            x:Name="moreButton"
            Margin="22,0,0,0"
            HorizontalAlignment="Left"
            Cursor="Hand"
            Visibility="{Binding MoreButtonVisibility}"
            Click="MoreButton_Click"
            ToolTip="More apps">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="pill"
                        CornerRadius="14"
                        Padding="14,6"
                        Background="#99202020"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Text="&#xE712;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Foreground="White"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0" />
                            <TextBlock
                                Text="{Binding MoreButtonText}"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="White"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" />
                        </Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="#CC303030" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="#CC3A3A3A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup
            x:Name="morePopup"
            PlacementTarget="{Binding ElementName=moreButton}"
            Placement="Right"
            HorizontalOffset="10"
            StaysOpen="False"
            AllowsTransparency="True"
            PopupAnimation="Fade"
            Opened="MorePopup_Opened"
            Closed="MorePopup_Closed">
            <Border
                Margin="8"
                Padding="6"
                MinWidth="240"
                MaxHeight="480"
                CornerRadius="10"
                Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="moreList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="MoreItem_Click" Cursor="Hand" Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="row" CornerRadius="8" Padding="8" Background="Transparent">
                                                <DockPanel>
                                                    <!-- Preview: a snapshot filling a rounded box (ImageBrush on
                                                         the Border gives the corner clip for free), app icon until
                                                         the snapshot arrives, small app badge bottom-left. -->
                                                    <Grid DockPanel.Dock="Left" Width="112" Height="70" Margin="0,0,12,0">
                                                        <Border CornerRadius="6"
                                                                BorderBrush="#33FFFFFF"
                                                                BorderThickness="1"
                                                                Background="#FF2A2A2A">
                                                            <Border CornerRadius="5">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" AlignmentY="Top" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                        <Image Source="{Binding Icon}" Width="30" Height="30"
                                                               Visibility="{Binding PlaceholderVisibility}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding Icon}" Width="20" Height="20"
                                                               Margin="-6,0,0,-6"
                                                               HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <Image.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5" />
                                                            </Image.Effect>
                                                        </Image>
                                                    </Grid>
                                                    <TextBlock
                                                        Text="{Binding Title}"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap"
                                                        MaxHeight="36"
                                                        MaxWidth="180"
                                                        VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </StackPanel>
</Window>
