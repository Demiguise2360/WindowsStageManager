<Window
    x:Class="StageManager.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stage Manager Settings"
    Width="540"
    SizeToContent="Height"
    MaxHeight="900"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Icon="StageManager.ico"
    Background="{DynamicResource PopupBackgroundBrush}"
    Foreground="{DynamicResource PrimaryTextBrush}"
    FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,8">

            <!-- Master switch -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}" Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="StageManager.ico" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Stage Manager" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="Keeps the app you are using in the centre and the others to the side, one stage per display." />
                    </StackPanel>
                    <CheckBox x:Name="enabledSwitch" Grid.Column="2" Style="{StaticResource SwitchStyle}"
                              Margin="12,0,0,0" Click="EnabledSwitch_Click" />
                </Grid>
            </Border>

            <!-- Shortcut + behaviour -->
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Behaviour" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowLabel}" Text="Keyboard shortcut" />
                            <TextBlock x:Name="shortcutHint" Style="{StaticResource RowHint}"
                                       Text="Turns Stage Manager on and off from anywhere." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="shortcutButton" Style="{StaticResource PillButton}" MinWidth="140"
                                    Click="ShortcutButton_Click"
                                    PreviewKeyDown="ShortcutButton_PreviewKeyDown"
                                    LostKeyboardFocus="ShortcutButton_LostKeyboardFocus" />
                            <Button x:Name="clearShortcutButton" Style="{StaticResource PillButton}" MinWidth="0"
                                    Margin="6,0,0,0" Padding="9,5" Content="✕" ToolTip="Remove shortcut"
                                    Click="ClearShortcut_Click" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />

                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Show recent apps" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="When off, the strip stays hidden until you move the pointer to the left edge." />
                        </StackPanel>
                        <CheckBox x:Name="showRecentAppsSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                  Margin="12,0,0,0" Click="ShowRecentApps_Click" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />

                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Apps in the strip" />
                            <TextBlock Style="{StaticResource RowHint}" Text="How many recent apps are shown at once." />
                        </StackPanel>
                        <Slider x:Name="recentAppsSlider" Grid.Column="1" Width="150" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"
                                ValueChanged="RecentAppsSlider_ValueChanged" />
                        <TextBlock x:Name="recentAppsValue" Grid.Column="2" Style="{StaticResource RowLabel}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />

                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Show windows from an app" />
                            <TextBlock x:Name="windowsModeHint" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentTrack}" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="allAtOnceChoice" GroupName="windowsMode"
                                             Style="{StaticResource SegmentButton}" Content="All at once"
                                             Checked="WindowsMode_Checked" />
                                <RadioButton x:Name="oneAtATimeChoice" GroupName="windowsMode"
                                             Style="{StaticResource SegmentButton}" Content="One at a time"
                                             Checked="WindowsMode_Checked" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />

                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Click wallpaper to reveal desktop" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Clicking empty desktop moves the windows aside; click again to bring them back." />
                        </StackPanel>
                        <CheckBox x:Name="clickWallpaperSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                  Margin="12,0,0,0" Click="ClickWallpaper_Click" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />

                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Hide desktop icons" />
                            <TextBlock Style="{StaticResource RowHint}" Text="Icons reappear when a display shows the desktop." />
                        </StackPanel>
                        <CheckBox x:Name="hideIconsSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                  Margin="12,0,0,0" Click="HideIcons_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Displays -->
            <Grid>
                <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Displays" />
                <Button Style="{StaticResource PillButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="10,2" Margin="0,-4,0,0" Content="Identify" Click="Identify_Click" />
            </Grid>
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel x:Name="displayChoices" Margin="16,12,16,6" />
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Ask on startup" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="Choose the displays each time Stage Manager starts with more than one attached." />
                        </StackPanel>
                        <CheckBox x:Name="askOnStartupSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                                  Margin="12,0,0,0" Click="AskOnStartup_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System -->
            <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="System" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingsRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" VerticalAlignment="Center" Text="Start with Windows" />
                    <CheckBox x:Name="autostartSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}"
                              Margin="12,0,0,0" Click="Autostart_Click" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
